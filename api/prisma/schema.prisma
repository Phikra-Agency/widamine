generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(uuid())
  name                 String
  email                String              @unique
  notificationEmail    String?
  password             String
  role                 String
  admin                Boolean             @default(false)
  image                String?
  gender               String?
  motifAssignments     MotifPractitioner[]
  assignedAppointments Appointment[]       @relation("AssignedPractitionerAppointments")
  availabilityBlocks   AvailabilityBlock[]
  resourceAssignments  ResourcePractitioner[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Motif {
  id                         String              @id @default(uuid())
  name                       String              @unique
  slug                       String              @unique
  description                String?
  duration                   Int                 @default(30)
  numberOfSessions           Int                 @default(1)
  isActive                   Boolean             @default(true)
  isOnlineBookable           Boolean             @default(false)
  requiresPractitionerChoice Boolean             @default(false)
  pendingTtlHours            Int                 @default(24)
  color                      String              @default("#3b82f6")
  category                   String?
  sessions                   Session[]
  practitionerAssignments    MotifPractitioner[]
  resourceAssignments        MotifResource[]
  appointments               Appointment[]
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
}

model Session {
  id            String      @id @default(uuid())
  number        Int
  duration      Int         @default(30)
  motifId       String
  motif         Motif       @relation(fields: [motifId], references: [id])
  schedules     Schedule[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Patient {
  id             String       @id @default(uuid())
  firstName      String
  lastName       String
  email          String?
  phone          String       @unique
  dateOfBirth    DateTime?
  gender         String?
  address        String?
  city           String?
  postalCode     String?
  country        String       @default("Maroc")
  medicalHistory String?
  appointments   Appointment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Appointment {
  id             String            @id @default(uuid())
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id])
  name           String
  email          String
  phone          String
  context        String?
  status         String            @default("PENDING")
  timezone       String            @default("Africa/Casablanca")
  sessionNumber  Int               @default(1)
  expiresAt      DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  completedAt    DateTime?
  motifId        String
  motif          Motif             @relation(fields: [motifId], references: [id])
  practitionerId String?
  practitioner   User?             @relation("AssignedPractitionerAppointments", fields: [practitionerId], references: [id])
  resourceId     String?
  resource       Resource?         @relation(fields: [resourceId], references: [id])
  schedules      Schedule[]
  notifications  NotificationLog[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([patientId])
  @@index([motifId])
  @@index([status])
}

model Schedule {
  id            String      @id @default(uuid())
  datetime      DateTime
  sessionId     String
  session       Session     @relation(fields: [sessionId], references: [id])
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([datetime])
  @@index([appointmentId])
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String
  context   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model MotifPractitioner {
  id             String   @id @default(uuid())
  motifId        String
  practitionerId String
  priority       Int      @default(0)
  isPreferred    Boolean  @default(false)
  isActive       Boolean  @default(true)
  motif          Motif    @relation(fields: [motifId], references: [id])
  practitioner   User     @relation(fields: [practitionerId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([motifId, practitionerId])
}

model Resource {
  id                  String                 @id @default(uuid())
  name                String
  slug                String                 @unique
  type                String
  description         String?
  priority            Int                    @default(0)
  isActive            Boolean                @default(true)
  motifAssignments    MotifResource[]
  practitionerAssignments ResourcePractitioner[]
  appointments        Appointment[]
  availabilityBlocks  AvailabilityBlock[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([priority])
  @@index([isActive])
}

model ResourcePractitioner {
  id             String   @id @default(uuid())
  resourceId     String
  practitionerId String
  priority       Int      @default(0)
  isPreferred    Boolean  @default(false)
  isActive       Boolean  @default(true)
  resource       Resource @relation(fields: [resourceId], references: [id])
  practitioner   User     @relation(fields: [practitionerId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([resourceId, practitionerId])
}

model MotifResource {
  id          String   @id @default(uuid())
  motifId     String
  resourceId  String
  priority    Int      @default(0)
  isPreferred Boolean  @default(false)
  isRequired  Boolean  @default(false)
  motif       Motif    @relation(fields: [motifId], references: [id])
  resource    Resource @relation(fields: [resourceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([motifId, resourceId])
}

model AvailabilityBlock {
  id             String    @id @default(uuid())
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  isActive       Boolean   @default(true)
  practitionerId String?
  practitioner   User?     @relation(fields: [practitionerId], references: [id])
  resourceId     String?
  resource       Resource? @relation(fields: [resourceId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([startsAt, endsAt])
}

model NotificationLog {
  id            String    @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  channel       String
  recipientType String
  recipient     String
  provider      String?
  status        String    @default("PENDING")
  message       String?
  externalId    String?
  error         String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([appointmentId])
  @@index([status])
}

model ChatLead {
  id        String   @id @default(uuid())
  name      String
  email     String
  createdAt DateTime @default(now())
}

model AppSettings {
  id                  String   @id @default(uuid())
  singletonKey        String   @unique @default("default")
  smsEnabled          Boolean  @default(false)
  emailEnabled        Boolean  @default(true)
  inAppEnabled        Boolean  @default(true)
  whatsappEnabled     Boolean  @default(false)
  smsConfirmation     Boolean  @default(true)
  smsReminder         Boolean  @default(true)
  smsCancellation     Boolean  @default(false)
  emailConfirmation   Boolean  @default(true)
  emailReminder       Boolean  @default(true)
  emailCancellation   Boolean  @default(true)
  inAppConfirmation   Boolean  @default(true)
  inAppReminder       Boolean  @default(true)
  inAppCancellation   Boolean  @default(false)
  whatsappConfirmation Boolean @default(false)
  whatsappReminder     Boolean @default(false)
  whatsappCancellation Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
