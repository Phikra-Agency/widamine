# Database
DATABASE_URL=mongodb://localhost:27017/widamine

# JWT
JWT_SECRET=your-jwt-secret-here

# Brevo API (free, 300 emails/day, real inboxes)
# 1. Sign up at https://www.brevo.com (free, no credit card)
# 2. Go to https://app.brevo.com/settings/keys/api → generate an API key (starts with xkeysib-)
# 3. Go to https://app.brevo.com/security/authorised_ips → add your IP or disable IP restriction
# 4. Go to https://app.brevo.com/senders — add & verify your sender email
# 5. Fill in the values below
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM_NAME=Widamine
SMTP_FROM_EMAIL=your-verified-sender@email.com

# If BREVO_API_KEY is not set, the app uses Ethereal Email (free fake inbox, no real delivery)
