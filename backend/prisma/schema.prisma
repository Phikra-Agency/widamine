generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  email                String              @unique
  password             String
  role                 String
  admin                Boolean             @default(false)
  image                String?
  services             Service[]           @relation("DoctorServices")
  motifAssignments     MotifPractitioner[]
  assignedAppointments Appointment[]       @relation("AssignedPractitionerAppointments")
  availabilityBlocks   AvailabilityBlock[]
  resourceAssignments  ResourcePractitioner[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model Category {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String    @unique
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Service {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  slug             String?       @unique
  price            Float
  categoryId       String        @db.ObjectId
  category         Category      @relation(fields: [categoryId], references: [id])
  sessions         Session[]
  appointments     Appointment[]
  motifs           Motif[]
  primaryDoctorId  String        @db.ObjectId
  primaryDoctor    User          @relation("DoctorServices", fields: [primaryDoctorId], references: [id])
  allowedDoctorIds String[]      @db.ObjectId
  allowedSalleIds  String[]      @db.ObjectId
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Session {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  number      Int
  duration    Int        @default(30)
  serviceId   String     @db.ObjectId
  service     Service    @relation(fields: [serviceId], references: [id])
  schedules   Schedule[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Patient {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  firstName      String
  lastName       String
  email          String?
  phone          String       @unique
  dateOfBirth    DateTime?
  gender         String?
  address        String?
  city           String?
  postalCode     String?
  country        String       @default("Maroc")
  medicalHistory String?
  appointments   Appointment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Appointment {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  patientId      String            @db.ObjectId
  patient        Patient           @relation(fields: [patientId], references: [id])
  name           String
  email          String
  phone          String
  context        String?
  status         String            @default("PENDING")
  timezone       String            @default("Africa/Casablanca")
  expiresAt      DateTime?
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  completedAt    DateTime?
  serviceId      String            @db.ObjectId
  service        Service           @relation(fields: [serviceId], references: [id])
  motifId        String?           @db.ObjectId
  motif          Motif?            @relation(fields: [motifId], references: [id])
  practitionerId String?           @db.ObjectId
  practitioner   User?             @relation("AssignedPractitionerAppointments", fields: [practitionerId], references: [id])
  resourceId     String?           @db.ObjectId
  resource       Resource?         @relation(fields: [resourceId], references: [id])
  schedules      Schedule[]
  notifications  NotificationLog[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([patientId])
  @@index([serviceId])
  @@index([status])
}

model Schedule {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  datetime      DateTime
  sessionId     String      @db.ObjectId
  session       Session     @relation(fields: [sessionId], references: [id])
  appointmentId String      @db.ObjectId
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([datetime])
  @@index([appointmentId])
}

model Contact {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String
  context   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Motif {
  id                         String              @id @default(auto()) @map("_id") @db.ObjectId
  name                       String              @unique
  slug                       String              @unique
  bookingType                String
  description                String?
  duration                   Int                 @default(30)
  isActive                   Boolean             @default(true)
  requiresPractitionerChoice Boolean             @default(false)
  pendingTtlHours            Int                 @default(24)
  color                      String              @default("#3b82f6")
  serviceId                  String              @db.ObjectId
  service                    Service             @relation(fields: [serviceId], references: [id])
  practitionerAssignments    MotifPractitioner[]
  resourceAssignments        MotifResource[]
  appointments               Appointment[]
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
}

model MotifPractitioner {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  motifId        String   @db.ObjectId
  practitionerId String   @db.ObjectId
  priority       Int      @default(0)
  isPreferred    Boolean  @default(false)
  isActive       Boolean  @default(true)
  motif          Motif    @relation(fields: [motifId], references: [id])
  practitioner   User     @relation(fields: [practitionerId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([motifId, practitionerId])
}

model Resource {
  id                  String                 @id @default(auto()) @map("_id") @db.ObjectId
  name                String
  slug                String                 @unique
  type                String
  description         String?
  priority            Int                    @default(0)
  isActive            Boolean                @default(true)
  motifAssignments    MotifResource[]
  practitionerAssignments ResourcePractitioner[]
  appointments        Appointment[]
  availabilityBlocks  AvailabilityBlock[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([priority])
  @@index([isActive])
}

// New: Resource-Doctor many-to-many relation
model ResourcePractitioner {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  resourceId     String   @db.ObjectId
  practitionerId String   @db.ObjectId
  priority       Int      @default(0)
  isPreferred    Boolean  @default(false)
  isActive       Boolean  @default(true)
  resource       Resource @relation(fields: [resourceId], references: [id])
  practitioner   User     @relation(fields: [practitionerId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([resourceId, practitionerId])
}

model MotifResource {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  motifId     String   @db.ObjectId
  resourceId  String   @db.ObjectId
  priority    Int      @default(0)
  isPreferred Boolean  @default(false)
  isRequired  Boolean  @default(false)
  motif       Motif    @relation(fields: [motifId], references: [id])
  resource    Resource @relation(fields: [resourceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([motifId, resourceId])
}

model AvailabilityBlock {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  startsAt       DateTime
  endsAt         DateTime
  reason         String?
  isActive       Boolean   @default(true)
  practitionerId String?   @db.ObjectId
  practitioner   User?     @relation(fields: [practitionerId], references: [id])
  resourceId     String?   @db.ObjectId
  resource       Resource? @relation(fields: [resourceId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([startsAt, endsAt])
}

model NotificationLog {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  appointmentId String    @db.ObjectId
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  channel       String
  recipientType String
  recipient     String
  provider      String?
  status        String    @default("PENDING")
  message       String?
  externalId    String?
  error         String?
  sentAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([appointmentId])
  @@index([status])
}

model AppSettings {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  singletonKey       String   @unique @default("default")
  smsEnabled         Boolean  @default(false)
  emailEnabled       Boolean  @default(true)
  inAppEnabled       Boolean  @default(true)
  smsConfirmation    Boolean  @default(true)
  smsReminder        Boolean  @default(true)
  smsCancellation    Boolean  @default(false)
  emailConfirmation  Boolean  @default(true)
  emailReminder      Boolean  @default(true)
  emailCancellation  Boolean  @default(true)
  inAppConfirmation  Boolean  @default(true)
  inAppReminder      Boolean  @default(true)
  inAppCancellation  Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
