							key={t.name}
							className='rounded-[2rem] border border-secondary/8 bg-white p-7 shadow-[0_18px_40px_rgba(26,54,70,0.05)]'
							initial={{ opacity: 0, y: 24 }}
							whileInView={{ opacity: 1, y: 0 }}
							viewport={{ once: true, amount: 0.18 }}
							transition={{ duration: 0.7, delay: idx * 0.08, ease: [0.22, 1, 0.36, 1] }}
						>
							<div className='flex items-center gap-3'>
								<img src={WIDAMINE_ASSETS.testimonials[idx % WIDAMINE_ASSETS.testimonials.length]} alt={t.name} className='h-12 w-12 rounded-full object-cover' />
								<div className='flex items-center gap-1 text-accent'>
									{Array.from({ length: 5 }).map((_, i) => (
										<Star key={i} size={16} className='fill-accent text-accent' />
									))}
								</div>
							</div>
							<p className='mt-6 text-base leading-8 text-secondary/70'>"{t.quote}"</p>
							<div className='mt-6 border-t border-secondary/8 pt-5'>
								<p className='text-sm font-semibold text-secondary'>{t.name}</p>
								<p className='mt-1 text-xs uppercase tracking-[0.18em] text-primary'>{t.service}</p>
							</div>
						</motion.article>
					))}
				</div>
			</RevealBlock>
		</section>
	)
}

