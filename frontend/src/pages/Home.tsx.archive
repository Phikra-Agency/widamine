const revealProps = {
	initial: { opacity: 0, y: 34, scale: 0.985, filter: 'blur(16px)' },
	whileInView: { opacity: 1, y: 0, scale: 1, filter: 'blur(0px)' },
	viewport: { once: true, amount: 0.2 },
	transition: { duration: 0.8, ease: [0.22, 1, 0.36, 1] as const },
}

function RevealBlock({
	children,
	className,
	delay = 0,
}: {
	children: ReactNode
	className?: string
	delay?: number
}) {
	return (
		<motion.div
			className={className}
			initial={revealProps.initial}
			whileInView={revealProps.whileInView}
			viewport={revealProps.viewport}
			transition={{ ...revealProps.transition, delay }}
		>
			{children}
		</motion.div>
	)
}

/* ── Botanical SVG accents ───────────────────────────────────────── */

function LeafAccent({ className, color = '#2e90c0', size = 200 }: { className?: string; color?: string; size?: number }) {
	return (
		<svg className={className} width={size} height={size} viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden='true'>
			<path d="M40 160c30-44 58-70 95-92 33-20 55-38 74-62-5 46-17 82-38 110-23 32-56 56-98 72-12 4-23 6-33 7Z" stroke={color} strokeWidth="1.5" strokeLinecap="round" opacity="0.5" />
			<path d="M58 146c15-15 28-25 43-33 13-8 27-17 41-32-7 20-15 33-27 47-12 13-29 25-50 35" stroke={color} strokeWidth="1.2" strokeLinecap="round" opacity="0.35" />
		</svg>
	)
}

function FlowerAccent({ className, color = '#e8c5b8', size = 120 }: { className?: string; color?: string; size?: number }) {
	return (
		<svg className={className} width={size} height={size} viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden='true'>
			<circle cx="60" cy="60" r="8" fill={color} opacity="0.3" />
			<ellipse cx="60" cy="38" rx="6" ry="14" fill={color} opacity="0.2" />
			<ellipse cx="60" cy="82" rx="6" ry="14" fill={color} opacity="0.2" />
			<ellipse cx="38" cy="60" rx="14" ry="6" fill={color} opacity="0.2" />
			<ellipse cx="82" cy="60" rx="14" ry="6" fill={color} opacity="0.2" />
			<ellipse cx="44" cy="44" rx="5" ry="12" fill={color} opacity="0.15" transform="rotate(-45 44 44)" />
			<ellipse cx="76" cy="76" rx="5" ry="12" fill={color} opacity="0.15" transform="rotate(-45 76 76)" />
			<ellipse cx="76" cy="44" rx="5" ry="12" fill={color} opacity="0.15" transform="rotate(45 76 44)" />
			<ellipse cx="44" cy="76" rx="5" ry="12" fill={color} opacity="0.15" transform="rotate(45 44 76)" />
		</svg>
	)
}

function BranchAccent({ className, color = '#1a3646', size = 180 }: { className?: string; color?: string; size?: number }) {
	return (
		<svg className={className} width={size} height={size} viewBox="0 0 180 180" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden='true'>
			<path d="M10 170C30 130 50 90 90 60c20-15 45-28 70-45" stroke={color} strokeWidth="1.5" strokeLinecap="round" opacity="0.3" />
			<path d="M90 60c-8-18-2-30 8-38" stroke={color} strokeWidth="1.2" strokeLinecap="round" opacity="0.25" />
			<path d="M90 60c12-14 28-12 32-2" stroke={color} strokeWidth="1.2" strokeLinecap="round" opacity="0.25" />
			<circle cx="96" cy="22" r="4" fill={color} opacity="0.12" />
			<circle cx="126" cy="56" r="3" fill={color} opacity="0.1" />
		</svg>
	)
}

/* ── Hero ────────────────────────────────────────────────────────── */

function Hero() {
	const heroRef = useRef<HTMLElement>(null)
	const { open } = useScheduleModalStore()

	useEffect(() => {
		const ctx = gsap.context(() => {
			gsap.fromTo(
				'[data-hero-anim]',
				{ opacity: 0, y: 22 },
				{
					opacity: 1,
					y: 0,
					duration: 1,
					stagger: 0.12,
					ease: 'power3.out',
					delay: 0.15,
				}
			)
		}, heroRef)
		return () => ctx.revert()
	}, [])

	return (
		<section ref={heroRef} className='relative z-[1200] min-h-[100svh] overflow-hidden isolate' style={{ backgroundColor: '#fff6f4' }}>
			{/* Organic background shapes */}
			<div className='absolute inset-0 pointer-events-none'>
				<div className='absolute -top-32 -left-32 h-[28rem] w-[28rem] rounded-full bg-accent/20 blur-3xl' />
				<div className='absolute -bottom-40 -right-40 h-[32rem] w-[32rem] rounded-full bg-primary/8 blur-3xl' />
				<div className='absolute top-1/3 left-1/4 h-64 w-64 rounded-full bg-primary/6 blur-3xl' />
				<div className='absolute bottom-1/4 right-1/3 h-48 w-48 rounded-full bg-accent/15 blur-2xl' />

				{/* Botanical SVGs */}
				<LeafAccent className='absolute -left-10 top-16 opacity-40 hidden lg:block' color='#1a3646' size={280} />
				<FlowerAccent className='absolute right-12 top-24 opacity-50 hidden lg:block' color='#e8c5b8' size={140} />
				<BranchAccent className='absolute -right-8 bottom-32 opacity-35 hidden lg:block' color='#2e90c0' size={220} />
				<LeafAccent className='absolute left-8 bottom-20 opacity-25 hidden sm:block lg:hidden' color='#2e90c0' size={100} />
				<FlowerAccent className='absolute right-4 top-1/2 opacity-30 sm:hidden' color='#e8c5b8' size={60} />
			</div>

			<PublicNavbar theme='light' />

			<motion.div
				className='relative z-0 flex min-h-[100svh] items-center justify-center px-6 pt-24 pb-20 sm:px-8 sm:pt-28 sm:pb-28'
				initial={{ opacity: 0, scale: 0.95 }}
				animate={{ opacity: 1, scale: 1 }}
				transition={{ duration: 0.8, ease: [0.25, 0.1, 0.25, 1] }}
			>
				<div className='w-full max-w-3xl text-center'>
					<motion.div
						className='flex flex-col items-center'
						initial={{ opacity: 0, y: 20, filter: 'blur(8px)' }}
						animate={{ opacity: 1, y: 0, filter: 'blur(0px)' }}
						transition={{ duration: 0.7, delay: 0.1, ease: [0.25, 0.46, 0.45, 0.94] }}
					>
						<div className='flex h-16 w-16 items-center justify-center rounded-full border border-secondary/10 bg-white/80 shadow-sm'>
							<img src={WIDAMINE_ASSETS.logos.primary} alt='Widamine' className='h-9 w-9 object-contain' />
						</div>
						<h1 className='mt-4 font-amoria text-xl tracking-[0.2em] text-secondary'>WIDAMINE</h1>
						<p className='mt-1 text-[10px] uppercase tracking-[0.34em] text-secondary/50'>Sobriété Esthétique</p>
					</motion.div>

					<motion.h2
						className='mt-8 font-amoria text-[2.2rem] leading-[1.08] text-secondary sm:text-5xl sm:leading-[1.03] md:text-6xl md:leading-[1.01]'
						initial={{ opacity: 0, y: 30, filter: 'blur(10px)' }}
						animate={{ opacity: 1, y: 0, filter: 'blur(0px)' }}
						transition={{ duration: 0.8, delay: 0.3, ease: [0.25, 0.46, 0.45, 0.94] }}
					>
						Bienvenue dans <span className='italic text-primary'>la jungle</span> de la
						<br className='hidden sm:block' />
						dermatologie <span className='italic text-primary'>esthétique</span> et laser.
					</motion.h2>

					<motion.p
						className='mx-auto mt-6 max-w-xl text-base leading-8 text-secondary/60 sm:text-lg sm:leading-9'
						initial={{ opacity: 0, y: 18, filter: 'blur(6px)' }}
						animate={{ opacity: 1, y: 0, filter: 'blur(0px)' }}
						transition={{ duration: 0.6, delay: 0.6, ease: [0.25, 0.46, 0.45, 0.94] }}
					>
						Que ce soit pour des rides, de la cicatrisation, des taches ou une simple envie de retrouver une peau saine et éclatante, nous avons la solution adaptée.
					</motion.p>

					<motion.div
						className='mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row'
						initial={{ opacity: 0, y: 20, filter: 'blur(6px)' }}
						animate={{ opacity: 1, y: 0, filter: 'blur(0px)' }}
						transition={{ duration: 0.6, delay: 0.75, ease: [0.25, 0.46, 0.45, 0.94] }}
					>
						<button
							onClick={open}
							className='group inline-flex items-center gap-2 rounded-full bg-primary px-8 py-4 text-sm font-semibold text-white shadow-[0_14px_30px_rgba(46,144,192,0.28)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-primary/90 hover:shadow-[0_18px_40px_rgba(46,144,192,0.35)] active:translate-y-0'
						>
							Prendre rendez-vous
							<ArrowUpRightIcon size={18} className='transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5' />
						</button>
					</motion.div>
				</div>
			</motion.div>
		</section>
	)
}

/* ── Services (3 colorful cards) ─────────────────────────────────── */

function Services() {
	return (
		<section className='py-20 sm:py-28 lg:py-36' style={{ backgroundColor: '#fff6f4' }}>
			<RevealBlock className='mx-auto max-w-6xl px-6 sm:px-8'>
				<div className='text-center'>
					<p className='text-xs font-semibold uppercase tracking-[0.28em] text-primary'>L'energie du</p>
					<h2 className='mt-3 font-amoria text-4xl text-secondary md:text-5xl'>Widamine Center</h2>
					<p className='mx-auto mt-5 max-w-2xl text-base leading-8 text-secondary/60'>
						Que ce soit pour des rides, de la cicatrisation, des taches ou une simple envie de retrouver une peau saine et éclatante, nous avons la solution adaptée.
					</p>
					<Link to='/appointment' className='mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-7 py-3.5 text-sm font-semibold text-white shadow-[0_12px_28px_rgba(46,144,192,0.25)] transition-all hover:-translate-y-0.5 hover:bg-primary/90 hover:shadow-[0_16px_36px_rgba(46,144,192,0.32)]'>
						Découvrir nos soins
						<ArrowUpRightIcon size={16} />
					</Link>
				</div>

				<div className='mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3'>
					{SERVICES.map((service, idx) => (
						<motion.div
							key={service.title}
							className='group relative overflow-hidden rounded-[2rem] p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_50px_rgba(26,54,70,0.1)]'
							style={{ backgroundColor: `${service.color}12`, border: `1px solid ${service.color}18` }}
							initial={{ opacity: 0, y: 24 }}
							whileInView={{ opacity: 1, y: 0 }}
							viewport={{ once: true, amount: 0.2 }}
							transition={{ duration: 0.6, delay: idx * 0.1, ease: [0.22, 1, 0.36, 1] }}
						>
							<div className='mb-6 flex h-14 w-14 items-center justify-center rounded-2xl text-2xl' style={{ backgroundColor: `${service.color}18` }}>
								{service.icon}
							</div>
							<p className='text-[11px] font-semibold uppercase tracking-[0.24em]' style={{ color: service.color }}>{service.eyebrow}</p>
							<h3 className='mt-2 text-xl font-semibold text-secondary'>{service.title}</h3>
							<p className='mt-3 text-sm leading-7 text-secondary/60'>{service.description}</p>
							<div className='mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-primary'>
								Découvrir le traitement
								<ArrowUpRightIcon size={14} className='transition-transform group-hover:translate-x-0.5' />
							</div>
						</motion.div>
					))}
				</div>
			</RevealBlock>
		</section>
	)
}

/* ── La méthode (3 steps) ───────────────────────────────────────── */

function MethodSection() {
	return (
		<section className='py-20 sm:py-28 lg:py-36' style={{ backgroundColor: '#fff6f4' }}>
			<RevealBlock className='mx-auto max-w-6xl px-6 sm:px-8'>
				<div className='text-center'>
					<p className='text-xs font-semibold uppercase tracking-[0.28em] text-primary'>La méthode</p>
					<h2 className='mt-3 font-amoria text-4xl text-secondary md:text-5xl'>Widamine Center</h2>
				</div>

				<div className='mt-16 grid gap-6 sm:grid-cols-3'>
					{CARE_UNIVERSES.map((universe, idx) => (
						<motion.div
							key={universe.title}
							className='group relative overflow-hidden rounded-[2rem] border border-secondary/8 bg-white p-8 shadow-[0_18px_40px_rgba(26,54,70,0.05)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_24px_50px_rgba(26,54,70,0.1)]'
							initial={{ opacity: 0, y: 24 }}
							whileInView={{ opacity: 1, y: 0 }}
							viewport={{ once: true, amount: 0.2 }}
							transition={{ duration: 0.6, delay: idx * 0.12, ease: [0.22, 1, 0.36, 1] }}
						>
							<div className='pointer-events-none absolute -right-6 top-0 h-20 w-20 rounded-full blur-3xl' style={{ backgroundColor: `${universe.color}15` }} />
							<div className='mb-6 flex h-14 w-14 items-center justify-center rounded-2xl text-2xl' style={{ backgroundColor: `${universe.color}12` }}>
								{universe.icon}
							</div>
							<p className='text-[11px] font-semibold uppercase tracking-[0.24em]' style={{ color: universe.color }}>{universe.eyebrow}</p>
							<h3 className='mt-2 text-xl font-semibold text-secondary'>{universe.title}</h3>
							<p className='mt-3 text-sm leading-7 text-secondary/60'>{universe.description}</p>
							<div className='mt-5 space-y-2'>
								{universe.items.map((item) => (
									<div key={item} className='flex items-start gap-2.5 text-sm text-secondary/65'>
										<span className='mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full' style={{ backgroundColor: universe.color }} />
										<span>{item}</span>
									</div>
								))}
							</div>
							<div className='mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-primary'>
								Découvrir le traitement
								<ArrowUpRightIcon size={14} className='transition-transform group-hover:translate-x-0.5' />
							</div>
						</motion.div>
					))}
				</div>
			</RevealBlock>
		</section>
	)
}

