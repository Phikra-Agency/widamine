# Database
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://widamine:your_secure_password_here@postgres:5432/widamine_main

# Backend
BACKEND_PORT=3001
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# Email (Brevo)
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM=info@widamineaestheticcenter.com

# Frontend URLs
FRONTEND_URL=https://widamineaestheticcenter.com
ADMIN_URL=https://admin.widamineaestheticcenter.com
VITE_ADMIN_URL=https://admin.widamineaestheticcenter.com

# Ports
ADMIN_PORT=8080
LANDING_PORT=8081

# Node Environment
NODE_ENV=production
